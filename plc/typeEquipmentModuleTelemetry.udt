TYPE "typeEquipmentModuleTelemetry"
TITLE = EM telemetry datagram payload
//
// Serialized with the Serialize instruction and sent as one UDP datagram.
// Field ORDER and SIZES are the wire contract with the collector
// (collector/udp_receiver.py) — do not reorder or resize fields without
// bumping VERSION and updating the collector parser.
//
// All fields land on even byte offsets so the serialized layout has no
// alignment padding surprises.  Serialized size: v3 = 1108 bytes; v4 = 1142;
// v5 = 1406.  Members are APPEND-ONLY, so every earlier offset is unchanged
// and each version is a strict superset of the one before — the collector
// accepts v4 and v5 side by side across a mixed fleet.
//
VERSION : 0.5
   STRUCT
      // NOTE: "version" must stay quoted — VERSION is a TIA keyword (it is the
      // block attribute above), and an unquoted member trips the external
      // source import with: Syntax error: The specified value "version" is
      // invalid. Same reason "step" is quoted below.
      "version" : USInt := 5;             // wire format version
      msgType : USInt;                    // 1 = event, 2 = heartbeat
      statusBits : Word;                  // bit0 automatic, bit1 fault, bit2 running,
                                          // bit3 paused, bit4 stopped, bit5 unknown,
                                          // bit6 stepFaulted, bit7 interlockOk,
                                          // bit8 extAlarmActive, bit9 reset
      modeBits : Word;                    // bit0 idle, bit1 stepMode, bit2 mesBypass,
                                          // bit3 dryCycle, bit4 endOfCycle,
                                          // bit5 pauseAtHome, bit6 requestEntry
      activeSequence : Int;               // 0 = no sequence active
      seq : UDInt;                        // per-EM datagram counter (gap detection)
      stepActiveTime : Time;              // time in current step (ms)
      plcTime : LDT;                      // CPU time, ns since 1970-01-01 UTC
      stationName : String[32];
      emLabel : String[16];
      "step" : String[60];                // active sequence's current step
      stepDescription : String[200];
      alarmMessage : String[200];         // status.alarm.message (PLC-composed)
      interlockFails : String[160];       // ALL failing interlock conditions,
                                          // '; '-separated, first-out first
      faultConditions : String[200];      // failing step-permissive conditions,
                                          // latched on the SCAN the step fault
                                          // rose ('; '-separated); '' when the
                                          // fault is not permissive-driven
      waitingOn : String[200];            // failing permissives of the ACTIVE
                                          // step while healthily dwelling past
                                          // dwellCaptureDelay — the live flow
                                          // reason (blocked/starved deduced
                                          // collector-side); '' when not dwelling
      lineName : String[32];              // v4: line/site id the PLC self-declares,
                                          // e.g. 'MOD1'.  Serializes at offset
                                          // 1108; v3 offsets are unchanged.  The
                                          // collector routes on this (not source
                                          // IP), so it survives NAT / re-IP.
      branchTaken : String[60];           // v5 @1142: nextStep of the branch that
                                          // actually satisfied on this step; ''
                                          // until the sequencer's path is known
      dwellReason : String[200];          // v5 @1204: conditions of THAT branch
                                          // which were unmet during the dwell —
                                          // waitingOn is the union over ALL
                                          // branches and so always carries the
                                          // discriminator of the branch not
                                          // taken.  This is the attributable
                                          // flow reason; '' when unresolved.
                                          // APPEND new members after this one.
   END_STRUCT;

END_TYPE
